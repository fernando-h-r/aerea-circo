---
const programs = [
  {
    title: 'Cursos regulares',
    ctaLabel: 'Ver horarios',
    href: '/formacion#regulares',
    image: '/images/trapezio-trapeze.webp',
    alt: 'Clase regular de trapecio fijo',
  },
  {
    title: 'Talleres intensivos',
    ctaLabel: 'Ver talleres',
    href: '/formacion#intensivos',
    image: '/images/aerial-silk-ilma-akrobatiaa-silkilla-c-img-2.webp',
    alt: 'Taller intensivo de técnica en telas aéreas',
  },
  {
    title: 'Formación anual',
    ctaLabel: 'Ver programa',
    href: '/formacion#anual',
    image: '/images/fijm-2013-014.webp',
    alt: 'Programa anual de formación en circo contemporáneo',
  },
  {
    title: 'Inscripción directa',
    ctaLabel: 'Contactar escuela',
    href: '/contacto',
    image: '/images/high-wire.webp',
    alt: 'Entrenamiento de equilibrio en sala de prácticas',
  },
];
---

<section id="programas-rapidos" class="section-programs" aria-label="Programas formativos">
  <div class="forja-container">
    <div class="programs-grid">
      {programs.map((item, idx) => (
        <article class="program-tile" data-forja-reveal data-forja-delay={idx * 65}>
          <div class="program-tile__media" aria-hidden="true">
            <img
              src={item.image}
              alt={item.alt}
              width="480"
              height="480"
              loading="lazy"
              decoding="async"
              class="program-tile__img"
            />
            <div class="program-tile__scrim"></div>
          </div>
          <div class="program-tile__overlay">
            <h3 class="program-tile__title">{item.title}</h3>
            <a href={item.href} class="program-tile__cta hover-tactile-press">
              {item.ctaLabel}
            </a>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .section-programs {
    background-color: var(--color-bg);
    padding-block: 4rem;
  }

  .programs-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1.25rem;
  }

  .program-tile {
    position: relative;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    background-color: var(--color-surface-deep);
  }

  .program-tile__media {
    position: absolute;
    inset: 0;
  }

  .program-tile__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 360ms var(--ease-out);
  }

  .program-tile__scrim {
    position: absolute;
    inset: 0;
    background: var(--hero-scrim-mobile);
  }

  .program-tile__overlay {
    position: relative;
    z-index: 2;
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    align-items: flex-start;
  }

  .program-tile__title {
    margin: 0;
    padding: 1.15rem 1.25rem;
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 1.8vw, 1.625rem);
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.02em;
    color: var(--color-accent-contrast);
  }

  .program-tile__cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 48px;
    padding: 0.75rem 1.35rem;
    background-color: var(--color-accent);
    color: var(--color-accent-contrast);
    font-family: var(--font-display);
    font-size: 0.9375rem;
    font-weight: 600;
    text-decoration: none;
    transition: background-color var(--duration-fast) var(--ease-out), transform 140ms var(--ease-out);
  }

  @media (hover: hover) and (pointer: fine) {
    .program-tile:hover .program-tile__img {
      transform: scale(1.04);
    }

    .program-tile__cta:hover,
    .program-tile__cta:focus-visible {
      background-color: var(--color-accent-hover);
    }
  }

  @media (max-width: 1024px) {
    .programs-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 767px) {
    .section-programs {
      padding-block: 2.5rem;
    }

    .programs-grid {
      display: flex;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      touch-action: pan-x pan-y;
      gap: 1rem;
      padding-bottom: 0.5rem;
    }

    .program-tile {
      flex: 0 0 78%;
      scroll-snap-align: start;
      aspect-ratio: 4 / 3;
    }
  }
</style>
