---
const highlights = [
  {
    title: 'Disciplinas aéreas y de suelo',
    ctaLabel: 'Explorar disciplinas',
    href: '/disciplinas',
    image: '/images/aerial-silk-ilma-akrobatiaa-silkilla-c-img.webp',
    alt: 'Entrenamiento en telas aéreas al aire libre sobre estructura metálica',
  },
  {
    title: 'Equilibrio y técnica circense',
    ctaLabel: 'Ver programas',
    href: '/formacion',
    image: '/images/high-wire.webp',
    alt: 'Artista ejecutando equilibrio sobre alambre tenso en escenario',
  },
  {
    title: 'Compañía en creación',
    ctaLabel: 'Conocer la compañía',
    href: '/compania',
    image: '/images/aerial-silk-ilma-akrobatiaa-silkilla-c-img-2.webp',
    alt: 'Acrobacia en tela aérea con composición corporal suspendida',
  },
];
---

<section id="disciplinas-destacadas" class="section-highlights" aria-label="Disciplinas y compañía">
  <div class="forja-container">
    <div class="highlights-grid">
      {highlights.map((item, idx) => (
        <article class="highlight-tile" data-forja-reveal data-forja-delay={idx * 70}>
          <div class="highlight-tile__media" aria-hidden="true">
            <img
              src={item.image}
              alt={item.alt}
              width="600"
              height="600"
              loading="lazy"
              decoding="async"
              class="highlight-tile__img"
            />
            <div class="highlight-tile__scrim"></div>
          </div>
          <div class="highlight-tile__overlay">
            <h2 class="highlight-tile__title">{item.title}</h2>
            <a href={item.href} class="highlight-tile__cta hover-tactile-press">
              {item.ctaLabel}
            </a>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .section-highlights {
    padding-block: 1.5rem 3.5rem;
    background-color: var(--color-bg);
  }

  .highlights-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.5rem;
  }

  .highlight-tile {
    position: relative;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    background-color: var(--color-surface-deep);
  }

  .highlight-tile__media {
    position: absolute;
    inset: 0;
  }

  .highlight-tile__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 360ms var(--ease-out);
  }

  .highlight-tile__scrim {
    position: absolute;
    inset: 0;
    background: var(--hero-scrim-mobile);
  }

  .highlight-tile__overlay {
    position: relative;
    z-index: 2;
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    align-items: flex-start;
  }

  .highlight-tile__title {
    margin: 0;
    padding: 1.25rem 1.5rem;
    font-family: var(--font-display);
    font-size: clamp(1.375rem, 2.2vw, 1.875rem);
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.02em;
    color: var(--color-accent-contrast);
  }

  .highlight-tile__cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 48px;
    padding: 0.75rem 1.5rem;
    background-color: var(--color-primary);
    color: var(--color-accent-contrast);
    font-family: var(--font-display);
    font-size: 0.9375rem;
    font-weight: 600;
    text-decoration: none;
    transition: background-color var(--duration-fast) var(--ease-out), transform 140ms var(--ease-out);
  }

  @media (hover: hover) and (pointer: fine) {
    .highlight-tile:hover .highlight-tile__img {
      transform: scale(1.04);
    }

    .highlight-tile__cta:hover,
    .highlight-tile__cta:focus-visible {
      background-color: var(--color-accent);
    }
  }

  @media (max-width: 767px) {
    .section-highlights {
      padding-block: 1.25rem 2.25rem;
    }

    .highlights-grid {
      display: flex;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      touch-action: pan-x pan-y;
      gap: 1rem;
      padding-bottom: 0.5rem;
    }

    .highlight-tile {
      flex: 0 0 82%;
      scroll-snap-align: start;
      aspect-ratio: 4 / 3;
    }
  }
</style>
