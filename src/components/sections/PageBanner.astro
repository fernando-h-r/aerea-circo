---
interface Props {
  title: string;
  subtitle: string;
  image?: string;
  imageAlt?: string;
}

const {
  title,
  subtitle,
  image = '/images/duet-aerial-silk-fred-deb.webp',
  imageAlt = 'Escena de circo contemporáneo en AÉREA',
} = Astro.props;
---

<section class="page-banner" aria-label={title}>
  <div class="page-banner__media" aria-hidden="true">
    <img
      src={image}
      alt={imageAlt}
      width="1600"
      height="900"
      loading="eager"
      decoding="async"
      fetchpriority="high"
      class="page-banner__img"
    />
    <div class="page-banner__scrim"></div>
  </div>
  <div class="forja-container page-banner__content">
    <h1 class="page-banner__title">{title}</h1>
    <p class="page-banner__subtitle">{subtitle}</p>
  </div>
</section>

<style>
  .page-banner {
    position: relative;
    min-height: 340px;
    display: flex;
    align-items: flex-end;
    background-color: var(--color-surface-deep);
    overflow: hidden;
    padding-block: 3.5rem;
  }

  .page-banner__media {
    position: absolute;
    inset: 0;
  }

  .page-banner__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .page-banner__scrim {
    position: absolute;
    inset: 0;
    background: var(--hero-scrim-desktop);
  }

  .page-banner__content {
    position: relative;
    z-index: 2;
    max-width: 780px;
    margin-left: 0;
  }

  .page-banner__title {
    margin: 0 0 0.75rem 0;
    font-family: var(--font-display);
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 700;
    line-height: 1.08;
    letter-spacing: -0.025em;
    color: var(--color-accent-contrast);
  }

  .page-banner__subtitle {
    margin: 0;
    font-family: var(--font-body);
    font-size: clamp(1rem, 1.4vw, 1.1875rem);
    line-height: 1.55;
    color: var(--color-primary-contrast);
    text-wrap: pretty;
  }

  @media (max-width: 767px) {
    .page-banner {
      min-height: 280px;
      padding-block: 2.5rem;
    }
  }
</style>
