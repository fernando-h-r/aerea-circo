---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/layout/Header.astro';
import Footer from '@/components/layout/Footer.astro';
import PageBanner from '@/components/sections/PageBanner.astro';
import site from '@/content/site.json';

const teachers = [
  {
    name: 'Camila Valenzuela',
    role: 'Dirección pedagógica y telas aéreas',
    bio: 'Formada en danza contemporánea y técnicas aéreas en Santiago y Buenos Aires. Investiga la suspensión como extensión del peso y la respiración escénica.',
  },
  {
    name: 'Matías Orellana',
    role: 'Trapecio fijo y acrobacia de suelo',
    bio: 'Acróbata e intérprete con doce años de trayectoria en compañías independientes. Especializado en dinámica aérea, portes y preparación física consciente.',
  },
  {
    name: 'Florencia Riquelme',
    role: 'Expresión corporal y teatro físico',
    bio: 'Coreógrafa y docente de movimiento. Acompaña procesos de dramaturgia corporal, presencia escénica y composición grupal.',
  },
  {
    name: 'Tomás Sepúlveda',
    role: 'Malabarismo y equilibrio',
    bio: 'Malabarista e investigador de objetos y alambre tenso. Su trabajo cruza ritmo, manipulación contemporánea y música en escena.',
  },
];

const pillars = [
  {
    title: 'Cuerpo y técnica sin rigidez',
    text: 'Entrenamos fuerza, movilidad y control técnico respetando la anatomía de cada persona, lejos de la lógica competitiva de un gimnasio.',
  },
  {
    title: 'Diálogo entre disciplinas',
    text: 'Cada clase vincula el aparato circense con la danza, el juego espacial y la escucha colectiva.',
  },
  {
    title: 'Creación desde el primer nivel',
    text: 'Incluso en los cursos iniciales abrimos espacios de improvisación para que el movimiento tenga sentido expresivo propio.',
  },
];
---

<BaseLayout
  title={`La escuela · ${site.brand.name}`}
  description="Historia, filosofía, equipo docente, instalaciones y metodología de enseñanza de AÉREA en Santiago de Chile."
>
  <Header />
  <main id="top">
    <PageBanner
      title="La escuela"
      subtitle="Un espacio de formación artística y exploración corporal en Ñuñoa, Santiago, dedicado al circo contemporáneo."
      image="/images/fijm-2013-014.webp"
      imageAlt="Intérprete en tela aérea durante entrenamiento en altura"
    />

    <section class="school-section school-section--light">
      <div class="forja-container school-split">
        <div class="school-split__text" data-forja-reveal>
          <h2 class="school-h2">Historia y filosofía</h2>
          <p class="school-p">
            AÉREA nació en 2019 en Santiago de Chile como un lugar de encuentro entre artistas escénicos, docentes de circo y personas curiosas por descubrir el movimiento en altura y en suelo.
          </p>
          <p class="school-p">
            Entendemos el circo contemporáneo como un arte vivo capaz de conmover sin artificios. No buscamos la repetición mecánica de trucos, sino la comprensión profunda del cuerpo, el riesgo cuidado y la expresión personal.
          </p>
        </div>
        <div class="school-split__media" data-forja-reveal>
          <img
            src="/images/aerial-silk-ilma-akrobatiaa-silkilla-c-img.webp"
            alt="Jornada de entrenamiento en telas aéreas en AÉREA"
            width="900"
            height="675"
            loading="lazy"
            decoding="async"
            class="school-img"
          />
        </div>
      </div>
    </section>

    <section class="school-section school-section--surface">
      <div class="forja-container">
        <h2 class="school-h2">Metodología de enseñanza</h2>
        <div class="method-grid">
          {pillars.map((item) => (
            <article class="method-item" data-forja-reveal>
              <h3 class="school-h3">{item.title}</h3>
              <p class="school-p">{item.text}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="school-section school-section--light">
      <div class="forja-container">
        <h2 class="school-h2">Equipo docente</h2>
        <div class="teachers-grid">
          {teachers.map((t) => (
            <article class="teacher-item" data-forja-reveal>
              <h3 class="school-h3">{t.name}</h3>
              <p class="teacher-role">{t.role}</p>
              <p class="school-p">{t.bio}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="school-section school-section--rose">
      <div class="forja-container school-split">
        <div class="school-split__text" data-forja-reveal>
          <h2 class="school-h2">Instalaciones en Ñuñoa</h2>
          <p class="school-p">
            Nuestro galpón cuenta con estructura de rigging certificada a 7,5 metros de altura libre, ocho puntos de anclaje aéreo independientes, piso amortiguado para acrobacia, colchonetas de caída y una sala luminosa para expresión corporal y malabarismo.
          </p>
          <a href="/contacto" class="school-cta hover-tactile-press">
            Coordinar visita o inscripción
          </a>
        </div>
        <div class="school-split__media" data-forja-reveal>
          <img
            src="/images/trapezio-trapeze.webp"
            alt="Sala principal equipada con trapecio fijo y colchonetas"
            width="1024"
            height="680"
            loading="lazy"
            decoding="async"
            class="school-img"
          />
        </div>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>

<style>
  .school-section {
    padding-block: 4rem;
  }

  .school-section--light {
    background-color: var(--color-bg);
  }

  .school-section--surface {
    background-color: var(--color-surface);
  }

  .school-section--rose {
    background-color: var(--color-surface-rose);
    color: var(--color-primary);
  }

  .school-h2 {
    margin: 0 0 1.75rem 0;
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 2.8vw, 2.375rem);
    font-weight: 700;
    line-height: 1.12;
    letter-spacing: -0.025em;
    color: var(--color-heading);
  }

  .school-h3 {
    margin: 0 0 0.5rem 0;
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 700;
    line-height: 1.25;
    color: var(--color-heading);
  }

  .school-p {
    margin: 0 0 1rem 0;
    font-family: var(--font-body);
    font-size: 1.0625rem;
    line-height: 1.65;
    color: var(--color-text);
    text-wrap: pretty;
  }

  .school-split {
    display: grid;
    grid-template-columns: minmax(0, 6fr) minmax(0, 6fr);
    gap: 3rem;
    align-items: center;
  }

  .school-img {
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    display: block;
  }

  .method-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 2rem;
  }

  .method-item {
    border-top: 3px solid var(--color-accent);
    padding-top: 1.25rem;
  }

  .teachers-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 2.5rem;
  }

  .teacher-item {
    border-left: 4px solid var(--color-primary);
    padding-left: 1.25rem;
  }

  .teacher-role {
    margin: 0 0 0.75rem 0;
    font-family: var(--font-display);
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--color-accent);
  }

  .school-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 48px;
    margin-top: 0.75rem;
    padding: 0.75rem 1.75rem;
    background-color: var(--color-primary);
    color: var(--color-accent-contrast);
    font-family: var(--font-display);
    font-size: 0.9375rem;
    font-weight: 600;
    text-decoration: none;
  }

  @media (max-width: 960px) {
    .school-split,
    .method-grid,
    .teachers-grid {
      grid-template-columns: minmax(0, 1fr);
      gap: 1.75rem;
    }
  }
</style>
