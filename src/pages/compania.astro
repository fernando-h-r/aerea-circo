---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/layout/Header.astro';
import Footer from '@/components/layout/Footer.astro';
import PageBanner from '@/components/sections/PageBanner.astro';
import site from '@/content/site.json';

const members = [
  {
    name: 'Camila Valenzuela',
    role: 'Dirección escénica e intérprete aérea',
    detail: 'Telas aéreas, dramaturgia de altura y dirección general de montajes.',
  },
  {
    name: 'Matías Orellana',
    role: 'Intérprete acrobático y rigging escénico',
    detail: 'Trapecio, portes acrobáticos y diseño técnico de dispositivos suspendidos.',
  },
  {
    name: 'Florencia Riquelme',
    role: 'Coreografía y teatro físico',
    detail: 'Composición de movimiento, trabajo coral y dirección actoral.',
  },
  {
    name: 'Tomás Sepúlveda',
    role: 'Malabarismo y diseño sonoro en vivo',
    detail: 'Manipulación rítmica de objetos, alambre tenso y paisaje sonoro.',
  },
  {
    name: 'Javiera Méndez',
    role: 'Diseño de iluminación y espacio',
    detail: 'Arquitectura lumínica, atmósferas teatrales y escenografía mínima.',
  },
  {
    name: 'Diego Santibáñez',
    role: 'Producción artística y gestión',
    detail: 'Circulación nacional, residencias y vínculo con centros culturales.',
  },
];

const processStages = [
  {
    title: 'Investigación física',
    text: 'Partimos de preguntas corporales concretas: cómo dialoga el peso en suspensión con la gravedad, qué tensiones produce el silencio o el desequilibrio en escena.',
  },
  {
    title: 'Laboratorio de aparatos',
    text: 'Construimos y adaptamos puntos de anclaje, cuerdas, telas y objetos cotidianos para que el dispositivo técnico forme parte de la dramaturgia.',
  },
  {
    title: 'Composición y estreno',
    text: 'Ensayamos con ensayos abiertos al público de la escuela antes de estrenar cada obra en salas de Santiago y festivales.',
  },
];
---

<BaseLayout
  title={`Compañía · ${site.brand.name}`}
  description="Enfoque creativo, integrantes y proceso de creación de la compañía artística de AÉREA en Santiago."
>
  <Header />
  <main id="top">
    <PageBanner
      title="Compañía AÉREA"
      subtitle="Creación escénica contemporánea que cruza técnica circense, danza y música en vivo."
      image="/images/duet-aerial-silk-fred-deb.webp"
      imageAlt="Intérpretes de la compañía AÉREA en escena"
    />

    <section class="comp-section comp-section--light">
      <div class="forja-container comp-split">
        <div class="comp-split__text" data-forja-reveal>
          <h2 class="comp-h2">Enfoque creativo</h2>
          <p class="comp-p">
            La compañía artística de AÉREA funciona como un laboratorio permanente paralelo a la escuela. Nuestro trabajo nace de la urgencia por narrar desde el cuerpo en riesgo cuidado, prescindiendo del ornamento circense tradicional.
          </p>
          <p class="comp-p">
            Cada obra busca una relación íntima con quien observa: el aliento antes de soltar una tela, el sonido seco de los pies sobre la madera o la quietud de un equilibrio sostenido.
          </p>
        </div>
        <div class="comp-split__media" data-forja-reveal>
          <img
            src="/images/high-wire.webp"
            alt="Número de equilibrio sobre alambre en montaje de compañía"
            width="1024"
            height="797"
            loading="lazy"
            decoding="async"
            class="comp-img"
          />
        </div>
      </div>
    </section>

    <section class="comp-section comp-section--surface">
      <div class="forja-container">
        <h2 class="comp-h2">Integrantes</h2>
        <div class="members-grid">
          {members.map((m) => (
            <article class="member-item" data-forja-reveal>
              <h3 class="comp-h3">{m.name}</h3>
              <p class="member-role">{m.role}</p>
              <p class="comp-p">{m.detail}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="comp-section comp-section--light">
      <div class="forja-container">
        <h2 class="comp-h2">Proceso de creación de espectáculos</h2>
        <div class="process-grid">
          {processStages.map((s) => (
            <article class="process-item" data-forja-reveal>
              <h3 class="comp-h3">{s.title}</h3>
              <p class="comp-p">{s.text}</p>
            </article>
          ))}
        </div>
        <div class="comp-actions">
          <a href="/espectaculos" class="comp-cta hover-tactile-press">
            Explorar portafolio de espectáculos
          </a>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>

<style>
  .comp-section {
    padding-block: 4rem;
  }

  .comp-section--light {
    background-color: var(--color-bg);
  }

  .comp-section--surface {
    background-color: var(--color-surface);
  }

  .comp-h2 {
    margin: 0 0 1.75rem 0;
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 2.8vw, 2.375rem);
    font-weight: 700;
    line-height: 1.12;
    letter-spacing: -0.025em;
    color: var(--color-heading);
  }

  .comp-h3 {
    margin: 0 0 0.4rem 0;
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--color-heading);
  }

  .comp-p {
    margin: 0 0 1rem 0;
    font-family: var(--font-body);
    font-size: 1.0625rem;
    line-height: 1.65;
    color: var(--color-text);
  }

  .comp-split {
    display: grid;
    grid-template-columns: minmax(0, 6fr) minmax(0, 6fr);
    gap: 3rem;
    align-items: center;
  }

  .comp-img {
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    display: block;
  }

  .members-grid,
  .process-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 2rem;
  }

  .member-item {
    border-left: 4px solid var(--color-primary);
    padding-left: 1.25rem;
  }

  .member-role {
    margin: 0 0 0.5rem 0;
    font-family: var(--font-display);
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--color-accent);
  }

  .process-item {
    border-top: 3px solid var(--color-accent);
    padding-top: 1.25rem;
  }

  .comp-actions {
    margin-top: 2.5rem;
  }

  .comp-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 48px;
    padding: 0.75rem 1.75rem;
    background-color: var(--color-accent);
    color: var(--color-accent-contrast);
    font-family: var(--font-display);
    font-size: 0.9375rem;
    font-weight: 600;
    text-decoration: none;
  }

  @media (max-width: 960px) {
    .comp-split,
    .members-grid,
    .process-grid {
      grid-template-columns: minmax(0, 1fr);
      gap: 1.75rem;
    }
  }
</style>
